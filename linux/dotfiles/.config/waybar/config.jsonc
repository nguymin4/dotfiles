{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "sway/workspaces",
    "wlr/taskbar",
    "sway/mode"
  ],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "memory",
    "cpu",
    "temperature",
    "battery",
    "clock#time",
    "tray"
  ],
  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": false,
    "format": "<span size='110%'>{name}</span>{windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "   󰆍",
    "window-rewrite": {
      // Terminals
      "class<.*(term|alacritty|kitty|ghostty|foot|pty|console|wezterm|st-256color).*": "   \uf120",

      // Web browser
      "class<firefox|org.mozilla.firefox>": "   󰈹",
      "class<google-chrome|chromium>": "   ",
      "class<.*(brave|zen|librewolf|waterfox|tor-browser|edge|opera|falkon|epiphany|mullvad|vivaldi).*": "   \udb81\udd9f",

      // Editors & IDEs
      "class<code|vscodium>": "   󰨞",
      "title<.*NVIM.*>": "   ",

      // Communication
      "class<Slack|slack>": "   󰒱",
      "class<mattermost|Mattermost>": "   󰒱",
      "class<discord|vesktop|WebCord>": "   󰙯",
      "class<org.telegram.desktop>": "   ",
      "class<Signal>": "   󰭹",

      // Microsoft Office & PWAs
      "class<teams|com.microsoft.teams>": "   \udb80\udebb",
      "class<outlook|microsoft outlook>": "   \udb83\udd22",
      "class<word|microsoft word|libreoffice-writer>": "   \ue6a5",
      "class<excel|microsoft excel|libreoffice-calc>": "   \udb84\udf8f",
      "class<powerpoint|microsoft powerpoint>": "   󰈧",

      // Media
      "class<vlc>": "   󰕼",
      "class<spotify|Spotify>": "   ",

      // Utilities
      "class<albert>": "   \ue68f",
      "class<dolphin|Nautilus|Thunar|thunar>": "   \ue5fe",
      "class<obsidian>": "   󱓧"
    }
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": " {capacity}%",
    "format-time": "{H}:{M}",
    "format-discharging": "{icon} {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },
  "clock#time": {
    "interval": 1,
    "format": " {:%e %b %Y %H:%M:%S}",
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": "<span foreground='#e5c07b'></span> {usage}%",
    "format-warning": " {usage}%",
    "format-critical": " {usage}%",
    "states": {
      "warning": 60,
      "critical": 80
    },
    "tooltip": false
  },
  "memory": {
    "interval": 5,
    "format": "<span foreground='#e5c07b'></span> {}%",
    "format-warning": " {}%",
    "format-critical": " {}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "tooltip": false
  },
  "sway/mode": {
    "format": "{}",
    "tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "<span foreground='#e5c07b'>{icon}</span> {volume}% [{desc}]",
    "format-muted": "{icon} {volume}% [{desc}]",
    "format-icons": {
      "muted": "󰖁",
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕾"]
    },
    "on-click": "BLOCK_BUTTON=1 ~/.config/waybar/blocks/volume-pulseaudio -dF 1",
    "on-click-middle": "BLOCK_BUTTON=2 ~/.config/waybar/blocks/volume-pulseaudio -dF 1",
    "on-click-right": "BLOCK_BUTTON=3 ~/.config/waybar/blocks/volume-pulseaudio -dF 1",
    "tooltip": false
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 65,
    "critical-threshold": 85,
    "format": "<span foreground='#e5c07b'></span> {temperatureC}°C",
    "format-warning": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip": false
  },
  "tray": {
    "icon-size": 20,
    "spacing": 6
  }
}
